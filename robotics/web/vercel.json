{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self), serial=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
  ]
}
